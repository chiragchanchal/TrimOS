<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="24dp"
    android:minWidth="600dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 Universal Streaming Search"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search movies, TV series, actors, or genres across all installed apps"
        android:textColor="#B0FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Type movie, actor, show, or genre..."
        android:textColorHint="#60FFFFFF"
        android:textColor="#FFFFFF"
        android:background="@drawable/settings_choice_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/genreContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnSearchAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSearchSmartTube"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SmartTube"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSearchYoutube"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YouTube"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSearchNetflix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Netflix"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSearchPrime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Prime"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSearchHotstar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hotstar"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_bg"
            android:layout_margin="4dp" />
    </LinearLayout>

</LinearLayout>
