<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The glow is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F5FFFFFF"
                android:textSize="124sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowRadius="16"
                android:shadowDy="4" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#CCFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:shadowColor="#80000000"
                android:shadowRadius="10"
                android:shadowDy="2" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#D9FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:shadowColor="#80000000"
            android:shadowRadius="10"
            android:shadowDy="2" />
    </LinearLayout>

    <!-- Location caption pill, Apple TV Aerial style -->
    <LinearLayout
        android:id="@+id/dreamCaptionPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="54dp"
        android:layout_marginBottom="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/pill_bg"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dreamCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.04"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
